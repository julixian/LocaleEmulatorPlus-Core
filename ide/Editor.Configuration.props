<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Log|Win32"><Configuration>Log</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Log|x64"><Configuration>Log</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="NoLog|Win32"><Configuration>NoLog</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="NoLog|x64"><Configuration>NoLog</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <LepRepoRoot>$(MSBuildThisFileDirectory)..\</LepRepoRoot>
    <Keyword>MakeFileProj</Keyword>
    <WindowsTargetPlatformVersion Condition="'$(SDK_VER)' != ''">$(SDK_VER)</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
</Project>
